# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.3

# API Configuration
# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:5174"]

# Trusted Hosts Configuration (add your domain in production)
TRUSTED_HOSTS=["localhost","127.0.0.1","0.0.0.0","testserver","diagrammatic.next-zen.dev","your_domain.com"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
# Comma/JSON-list of reverse-proxy addresses only; do not add public client IPs.
TRUSTED_PROXY_IPS=[]

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-use-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24

# Email verification (Resend)
# Verify diagrammatic.next-zen.dev in Resend before using this sender.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Diagrammatic <no-reply@diagrammatic.next-zen.dev>"
# Optional override. Must be a public HTTPS image URL for email clients.
BRAND_LOGO_URL=https://diagrammatic.next-zen.dev/logo.png
# Use a separate random value in production; JWT_SECRET_KEY is used as a
# temporary fallback when this is omitted.
EMAIL_VERIFICATION_SECRET=replace-with-a-random-secret
EMAIL_VERIFICATION_EXPIRE_MINUTES=20
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
FRONTEND_URL=https://diagrammatic.next-zen.dev

# Google OAuth Configuration
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# AWS DynamoDB Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
DYNAMODB_USERS_TABLE=diagrammatic_users
DYNAMODB_DIAGRAMS_TABLE=diagrammatic_diagrams
DYNAMODB_PROBLEMS_TABLE=diagrammatic_problems
ANALYTICS_S3_BUCKET=diagrammatic

# Whisper transcription service (whisper-service local dev / deployed API Gateway URL)
WHISPER_SERVICE_URL=http://localhost:8001
